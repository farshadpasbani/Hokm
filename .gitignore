# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
.venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Training artifacts (regenerated every run; should never be in commits)
models/
plots/
game_logs/
summaries/
dev_cache/
*.pth           # model checkpoints anywhere in the tree
# ... except checkpoints deliberately committed: models_release/ is what the
# app auto-loads; checkpoints/ archives training milestones for warm-starts.
!models_release/*.pth
!checkpoints/*.pth

# Tabular / log outputs
*.xlsx
*.csv
*.log

# Node / React (hokm-mini-app has its own .gitignore too)
node_modules/

# OS
.DS_Store
Thumbs.db
